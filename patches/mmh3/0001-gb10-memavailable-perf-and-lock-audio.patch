+
+pub(crate) struct StreamGuard {
+    previous: *mut c_void,
+}
+
+impl StreamGuard {
+    pub(crate) fn enter(stream: &CudaStream) -> Self {
+        let previous = ACTIVE_STREAM.with(|slot| {
+            let prev = slot.get();
+            slot.set(stream.pointer());
+            prev
+        });
+        Self { previous }
+    }
+}
+
+impl Drop for StreamGuard {
+    fn drop(&mut self) {
+        ACTIVE_STREAM.with(|slot| slot.set(self.previous));
+    }
+}
+
+pub(crate) struct CudaStream {
+    raw: *mut c_void,
+    device: usize,
+}
+
+unsafe impl Send for CudaStream {}
+unsafe impl Sync for CudaStream {}
+
+impl CudaStream {
+    pub(crate) fn new() -> Result<Self, CudaError> {
+        let device = current_device()?;
+        let mut raw = ptr::null_mut();
+        // SAFETY: raw is a valid out pointer.
+        check(unsafe { mmh3_cuda_stream_create(&mut raw) })?;
+        Ok(Self { raw, device })
+    }
+
+    pub(crate) fn pointer(&self) -> *mut c_void {
+        self.raw
+    }
+
+    pub(crate) fn synchronize(&self) -> Result<(), CudaError> {
+        // SAFETY: raw is a live stream on self.device.
+        check(unsafe { mmh3_cuda_stream_synchronize(self.raw) })
+    }
+
+    pub(crate) fn begin_capture(&self) -> Result<(), CudaError> {
+        // SAFETY: raw is a live non-default stream.
+        check(unsafe { mmh3_cuda_stream_begin_capture(self.raw) })
+    }
+
+    pub(crate) fn end_capture(&self) -> Result<CudaGraphExec, CudaError> {
+        let mut exec = ptr::null_mut();
+        // SAFETY: raw is currently capturing.
+        check(unsafe { mmh3_cuda_stream_end_capture(self.raw, &mut exec) })?;
+        Ok(CudaGraphExec {
+            raw: exec,
+            device: self.device,
+        })
+    }
+}
+
+impl Drop for CudaStream {
+    fn drop(&mut self) {
+        if !self.raw.is_null() {
+            // SAFETY: raw was created by mmh3_cuda_stream_create.
+            unsafe {
+                let here = current_device().ok();
+                let _ = set_device(self.device);
+                mmh3_cuda_stream_destroy(self.raw);
+                if let Some(d) = here {
+                    let _ = set_device(d);
+                }
+            }
+        }
+    }
+}
+
