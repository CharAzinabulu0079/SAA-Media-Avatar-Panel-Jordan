@@ -306,3 +306,21 @@ extern "C" int mmh3_nvfp4_adapter_ranges(const int8_t *down, const float *down_s
     maximum_bf16_kernel<<<256, THREADS, 0, stream>>>(up, up_count, maxima + 1);
     return static_cast<int>(cudaGetLastError());
 }
+
+__global__ void advance_scales_kernel(unsigned *const *ptrs, int count) {
+    const int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < count) {
+        unsigned *pair = ptrs[idx];
+        pair[0] = pair[1];
+    }
+}
+
+extern "C" int mmh3_nvfp4_advance_scales(unsigned *const *ptrs, int count, cudaStream_t stream) {
+    if (count <= 0) {
+        return 0;
+    }
+    const int threads = 256;
+    const int blocks = (count + threads - 1) / threads;
+    advance_scales_kernel<<<blocks, threads, 0, stream>>>(ptrs, count);
+    return static_cast<int>(cudaGetLastError());
+}
