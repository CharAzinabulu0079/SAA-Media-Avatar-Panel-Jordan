     fill_f32_kernel<<<static_cast<unsigned>(block_count), threads_per_block>>>(data, value, count);
     return static_cast<int>(cudaGetLastError());
 }
+
+extern "C" int mmh3_cuda_zero(void *pointer, size_t bytes, cudaStream_t stream) {
+    return static_cast<int>(cudaMemsetAsync(pointer, 0, bytes, stream));
+}
+
+__global__ void accumulate_i32_to_u64_kernel(const int32_t *src, size_t count,
+                                             unsigned long long *dst) {
+    __shared__ unsigned long long shared[256];
+    unsigned long long sum = 0;
+    for (size_t i = threadIdx.x; i < count; i += blockDim.x) {
+        sum += static_cast<unsigned long long>(src[i]);
+    }
+    shared[threadIdx.x] = sum;
+    __syncthreads();
+    for (unsigned stride = blockDim.x / 2; stride > 0; stride >>= 1) {
+        if (threadIdx.x < stride) {
+            shared[threadIdx.x] += shared[threadIdx.x + stride];
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        *dst += shared[0];
+    }
+}
+
+extern "C" int mmh3_cuda_accumulate_i32_to_u64(const int32_t *src, size_t count,
+                                               uint64_t *dst, cudaStream_t stream) {
+    accumulate_i32_to_u64_kernel<<<1, 256, 0, stream>>>(
+        src, count, reinterpret_cast<unsigned long long *>(dst));
+    return static_cast<int>(cudaGetLastError());
+}
