+extern "C" int mmh3_cuda_stream_begin_capture(cudaStream_t stream) {
+    return static_cast<int>(cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreadLocal));
+}
+
+extern "C" int mmh3_cuda_stream_end_capture(cudaStream_t stream, cudaGraphExec_t *exec_out) {
+    cudaGraph_t graph = nullptr;
+    cudaError_t status = cudaStreamEndCapture(stream, &graph);
+    if (status != cudaSuccess) {
+        if (graph != nullptr) {
+            cudaGraphDestroy(graph);
+        }
+        cudaGetLastError();
+        return static_cast<int>(status);
+    }
+    status = cudaGraphInstantiate(exec_out, graph, 0);
+    cudaGraphDestroy(graph);
+    return static_cast<int>(status);
+}
