+/// The encoded sound as the target audio latent: the same layout, with the frame count matched
+/// to the canvas by truncation or zero padding, as the reference pipeline does.
+#[cfg(any(feature = "cuda", feature = "metal"))]
+fn lock_audio_latent(encoded: &Tensor, audio_shape: &[usize]) -> Result<Tensor, Box<dyn Error>> {
+    let &[channels, stereo, frames] = encoded.shape.as_slice() else {
+        return Err(format!(
+            "an encoded sound of shape {:?} is not [channels, stereo, frames]",
+            encoded.shape
+        )
+        .into());
+    };
+    let (&want_channels, &want_stereo, &want_frames) = match audio_shape {
+        [a, b, c] => (a, b, c),
+        _ => {
+            return Err(format!(
+                "the audio latent shape {audio_shape:?} is not three-dimensional"
+            )
+            .into())
+        }
+    };
+    if (channels, stereo) != (want_channels, want_stereo) {
+        return Err(format!(
+            "the encoded sound is {channels}x{stereo} but the audio latent is \
+             {want_channels}x{want_stereo}"
+        )
+        .into());
+    }
+    let keep = frames.min(want_frames);
+    let mut data = vec![0.0f32; want_channels * want_stereo * want_frames];
+    for channel in 0..want_channels {
+        for side in 0..want_stereo {
+            let from = (channel * want_stereo + side) * frames;
+            let to = (channel * want_stereo + side) * want_frames;
+            data[to..to + keep].copy_from_slice(&encoded.data[from..from + keep]);
+        }
+    }
+    Ok(Tensor::new(audio_shape.to_vec(), data))
+}
